---
const command = "bun add @opencoredev/social-sdk";
---

<div class="overflow-hidden rounded-blume border border-border bg-muted">
  <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-2 text-sm text-muted-foreground">
    <span>Install</span>
    <button class="cursor-pointer rounded-blume px-2 py-1 hover:bg-background hover:text-foreground" data-copy-command type="button">
      Copy
    </button>
  </div>
  <pre class="overflow-x-auto px-4 py-4"><code>{command}</code></pre>
</div>

<script define:vars={{ command }}>
  const button = document.querySelector("[data-copy-command]");
  button?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(command);
    button.textContent = "Copied";
  });
</script>
